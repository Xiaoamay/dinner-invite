<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#3a1d29" />
  <meta name="description" content="给范同学的一份晚餐邀请" />
  <title>给范同学的一份邀请</title>
  <style>
    :root {
      --wine: #3a1d29;
      --plum: #5a283b;
      --rose: #b8677f;
      --blush: #e7a9b7;
      --cream: #fff7f1;
      --paper: rgba(255, 250, 246, .90);
      --paper-border: rgba(255, 255, 255, .62);
      --ink: #4b2431;
      --muted: #8b5d6a;
      --shadow: rgba(48, 19, 29, .30);
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }

    body {
      font-family: "Noto Sans CJK SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 50% 22%, rgba(255, 221, 215, .16), transparent 30%),
        radial-gradient(circle at 12% 84%, rgba(219, 127, 150, .22), transparent 28%),
        radial-gradient(circle at 92% 72%, rgba(237, 176, 186, .15), transparent 26%),
        linear-gradient(150deg, #2e1822 0%, #4b2130 46%, #25131d 100%);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        linear-gradient(to bottom, rgba(18, 8, 12, .10), rgba(18, 8, 12, .02) 30%, rgba(18, 8, 12, .20) 100%),
        radial-gradient(ellipse at center, transparent 38%, rgba(17, 8, 12, .36) 100%);
    }

    .petal-layer {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 1;
    }

    .petal {
      position: absolute;
      top: -12vh;
      width: 14px;
      height: 22px;
      border-radius: 75% 25% 72% 28%;
      background: linear-gradient(145deg, rgba(255, 226, 226, .96), rgba(183, 88, 117, .90));
      box-shadow: 0 5px 12px rgba(76, 22, 39, .18), inset 3px 2px 5px rgba(255,255,255,.34);
      opacity: .78;
      transform-origin: 50% 60%;
      animation: fall linear infinite;
    }

    .petal::after {
      content: "";
      position: absolute;
      left: 2px;
      top: 5px;
      width: 2px;
      height: 12px;
      border-radius: 50%;
      background: rgba(125, 48, 72, .22);
      transform: rotate(12deg);
    }

    .petal.soft {
      filter: blur(1.7px);
      opacity: .34;
    }

    .petal.deep {
      background: linear-gradient(145deg, rgba(236, 164, 179, .95), rgba(142, 53, 82, .88));
    }

    @keyframes fall {
      0% {
        transform: translate3d(0, -10vh, 0) rotate(0deg) scale(.84);
        opacity: 0;
      }
      7% { opacity: .82; }
      25% {
        transform: translate3d(calc(var(--drift) * .28), 28vh, 0) rotate(95deg) scale(1);
      }
      52% {
        transform: translate3d(calc(var(--drift) * -.18), 58vh, 0) rotate(185deg) scale(.93);
      }
      78% {
        transform: translate3d(calc(var(--drift) * .46), 88vh, 0) rotate(260deg) scale(1.04);
      }
      100% {
        transform: translate3d(var(--drift), 118vh, 0) rotate(355deg) scale(.82);
        opacity: 0;
      }
    }

    .glow {
      position: fixed;
      left: 50%;
      top: 16%;
      width: min(70vw, 760px);
      aspect-ratio: 1;
      transform: translateX(-50%);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 223, 225, .17), rgba(255, 223, 225, 0) 70%);
      filter: blur(10px);
      pointer-events: none;
      z-index: 1;
    }

    .wrap {
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: 28px 18px 46px;
      position: relative;
      z-index: 3;
    }

    .card {
      width: min(690px, 100%);
      padding: clamp(30px, 6vw, 58px) clamp(22px, 6vw, 56px);
      position: relative;
      border-radius: 34px;
      background:
        linear-gradient(180deg, rgba(255, 252, 249, .94), rgba(255, 246, 243, .88));
      border: 1px solid var(--paper-border);
      box-shadow:
        0 30px 90px var(--shadow),
        0 4px 20px rgba(255,255,255,.06) inset,
        0 0 0 1px rgba(255,255,255,.10);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      text-align: center;
      animation: rise .9s cubic-bezier(.2,.8,.2,1) both;
    }

    .card::before,
    .card::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(166, 77, 101, .17);
      border-radius: 50%;
      pointer-events: none;
    }
    .card::before { width: 90px; height: 90px; top: 18px; left: 18px; }
    .card::after { width: 62px; height: 62px; bottom: 20px; right: 20px; }

    @keyframes rise {
      from { opacity: 0; transform: translateY(24px) scale(.985); }
      to { opacity: 1; transform: none; }
    }

    .eyebrow {
      margin: 0 auto 16px;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-size: 11px;
      letter-spacing: .28em;
      color: var(--rose);
      text-transform: uppercase;
    }

    .eyebrow::before,
    .eyebrow::after {
      content: "";
      width: 22px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(184,103,127,.58));
    }
    .eyebrow::after { transform: scaleX(-1); }

    .ornament {
      color: var(--rose);
      font-family: Georgia, "STSong", serif;
      font-size: 36px;
      line-height: 1;
      margin-bottom: 9px;
    }

    h1 {
      margin: 0;
      font-family: "Noto Serif CJK SC", "STSong", "Songti SC", serif;
      font-size: clamp(46px, 10vw, 70px);
      font-weight: 500;
      letter-spacing: .09em;
      line-height: 1.12;
      color: #4a202e;
    }

    .lead {
      margin: 12px 0 0;
      font-family: "Noto Serif CJK SC", "STSong", "Songti SC", serif;
      font-size: clamp(19px, 4.4vw, 23px);
      color: #845161;
      line-height: 1.7;
      letter-spacing: .04em;
    }

    .message {
      margin: 30px auto 28px;
      max-width: 470px;
      font-family: "Noto Serif CJK SC", "STSong", "Songti SC", serif;
      font-size: clamp(18px, 4.3vw, 22px);
      line-height: 2.05;
      letter-spacing: .06em;
      color: #4c2633;
    }

    .message .line {
      display: block;
      white-space: nowrap;
    }

    .message .accent {
      color: #a44f69;
      font-weight: 600;
    }

    .details {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 28px 0 24px;
    }

    .item {
      padding: 15px 10px 16px;
      border-radius: 20px;
      background: rgba(255,255,255,.56);
      border: 1px solid rgba(133, 67, 84, .10);
      box-shadow: 0 10px 22px rgba(109, 43, 62, .06);
    }

    .icon { font-size: 18px; margin-bottom: 8px; }
    .label { font-family: "Noto Sans CJK SC", sans-serif; font-size: 11px; font-weight: 600; letter-spacing: .18em; color: #a1717d; }
    .value { margin-top: 7px; font-family: "Noto Serif CJK SC", "STSong", serif; font-size: 15px; line-height: 1.55; color: #57303c; }

    .question {
      margin: 28px 0 15px;
      font-family: "Noto Serif CJK SC", "STSong", "Songti SC", serif;
      font-size: 19px;
      color: #6f3b4b;
      letter-spacing: .04em;
    }

    .actions {
      display: grid;
      gap: 10px;
    }

    button {
      width: 100%;
      border: 0;
      border-radius: 999px;
      padding: 15px 20px;
      font-size: 16px;
      font-weight: 600;
      letter-spacing: .05em;
      cursor: pointer;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      font-family: inherit;
    }

    .yes {
      color: #fff9f5;
      background: linear-gradient(90deg, #a34e68, #c06f86);
      box-shadow: 0 14px 28px rgba(154, 64, 91, .20);
    }
    .yes:hover { box-shadow: 0 16px 32px rgba(154,64,91,.26); transform: translateY(-1px); }

    .maybe {
      color: #6d4351;
      background: rgba(255,255,255,.58);
      border: 1px solid rgba(135, 71, 90, .15);
    }
    .maybe:hover { background: rgba(255,255,255,.78); }
    button:active { transform: scale(.985); }

    .tiny {
      margin-top: 18px;
      color: #a07480;
      font-size: 12px;
      line-height: 1.8;
      letter-spacing: .08em;
    }

    .overlay {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(45, 19, 29, .62);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .35s ease;
      z-index: 20;
    }
    .overlay.show { opacity: 1; pointer-events: auto; }

    .modal {
      width: min(520px, 100%);
      text-align: center;
      padding: 42px 24px 30px;
      border-radius: 30px;
      background: linear-gradient(180deg, rgba(255, 250, 246, .98), rgba(255, 239, 238, .97));
      border: 1px solid rgba(255,255,255,.75);
      box-shadow: 0 35px 100px rgba(25, 9, 16, .42);
      transform: translateY(14px) scale(.98);
      transition: transform .35s ease;
    }
    .overlay.show .modal { transform: none; }

    .big {
      font-size: 42px;
      color: var(--rose);
      margin-bottom: 8px;
    }

    .modal h2 {
      margin: 6px 0 12px;
      font-family: "Noto Serif CJK SC", "STSong", "Songti SC", serif;
      font-size: 35px;
      font-weight: 500;
      letter-spacing: .06em;
      color: #4a202e;
    }

    .modal p {
      color: #78505e;
      line-height: 1.9;
      margin: 0 auto 24px;
      max-width: 410px;
      font-family: "Noto Serif CJK SC", "STSong", "Songti SC", serif;
      font-size: 18px;
      letter-spacing: .04em;
    }

    .close {
      color: #fffaf7;
      background: linear-gradient(90deg, #a34e68, #c06f86);
    }

    .burst {
      position: fixed;
      left: 50%;
      top: 50%;
      font-size: 18px;
      z-index: 30;
      pointer-events: none;
      animation: burst 1.4s ease-out forwards;
    }

    @keyframes burst {
      from { opacity: 0; transform: translate(-50%,-50%) scale(.7); }
      12% { opacity: 1; }
      to {
        opacity: 0;
        transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(1.45) rotate(var(--r));
      }
    }

    @media (max-width: 560px) {
      .message {
        font-size: clamp(18px, 4.9vw, 21px);
        letter-spacing: .04em;
      }
      .message .line {
        white-space: normal;
      }
      .details { grid-template-columns: 1fr; }
      .item {
        display: grid;
        grid-template-columns: 32px 1fr;
        grid-template-rows: auto auto;
        text-align: left;
        column-gap: 5px;
        align-items: center;
      }
      .icon { grid-row: 1 / 3; font-size: 20px; }
      .label { font-size: 10px; }
      .value { margin-top: 1px; }
      .card { border-radius: 28px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>
  <div class="petal-layer" id="petals" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>

  <main class="wrap">
    <section class="card" aria-label="晚餐邀请">
      <div class="eyebrow">A little invitation</div>
      <div class="ornament">❦</div>
      <h1>范同学</h1>
      <p class="lead">今晚七点一刻，想请你吃顿饭。</p>

      <p class="message">
        <span class="line">没有特别正式的理由。</span>
        <span class="line">只是忽然觉得，</span>
        <span class="line accent">和你一起吃顿饭，</span>
        <span class="line">应该会是一件很开心的事。</span>
      </p>

      <div class="details">
        <div class="item">
          <div class="icon">♡</div>
          <div class="label">DATE</div>
          <div class="value">2026年8月24日</div>
        </div>
        <div class="item">
          <div class="icon">◷</div>
          <div class="label">TIME</div>
          <div class="value">晚上 7:15</div>
        </div>
        <div class="item">
          <div class="icon">⌖</div>
          <div class="label">PLACE</div>
          <div class="value">南海街小学</div>
        </div>
      </div>

      <div class="question"></div>
      <div class="actions">
        <button class="yes" id="yesBtn">♡ 好呀，今晚见</button>
        <button class="maybe" id="maybeBtn">让我想想</button>
      </div>
      <div class="tiny">不用着急，按你的心意就好。</div>
    </section>
  </main>

  <div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal">
      <div class="big">🌹</div>
      <h2 id="modalTitle">好，那今晚见。</h2>
      <p id="modalText">我会准时到。<br />希望今晚的晚风也刚刚好。</p>
      <button class="close" id="closeBtn">好 ♡</button>
    </div>
  </div>

  <script>
    const petalLayer = document.getElementById('petals');
    const petalCount = 34;

    for (let i = 0; i < petalCount; i++) {
      const petal = document.createElement('span');
      petal.className = 'petal' + (i % 7 === 0 ? ' soft' : '') + (i % 5 === 0 ? ' deep' : '');
      petal.style.left = `${Math.random() * 100}%`;
      petal.style.setProperty('--drift', `${(Math.random() - 0.5) * 260}px`);
      petal.style.animationDuration = `${8 + Math.random() * 9}s`;
      petal.style.animationDelay = `${-Math.random() * 16}s`;
      petal.style.width = `${10 + Math.random() * 9}px`;
      petal.style.height = `${16 + Math.random() * 13}px`;
      petal.style.transform = `rotate(${Math.random() * 360}deg)`;
      petalLayer.appendChild(petal);
    }

    const overlay = document.getElementById('overlay');
    const yesBtn = document.getElementById('yesBtn');
    const maybeBtn = document.getElementById('maybeBtn');
    const closeBtn = document.getElementById('closeBtn');
    const modalTitle = document.getElementById('modalTitle');
    const modalText = document.getElementById('modalText');

    function openModal(title, text) {
      modalTitle.textContent = title;
      modalText.innerHTML = text;
      overlay.classList.add('show');
    }

    function burstPetals() {
      const symbols = ['🌹', '♡', '✦', '·', '❀'];
      for (let i = 0; i < 22; i++) {
        const el = document.createElement('div');
        el.className = 'burst';
        el.textContent = symbols[Math.floor(Math.random() * symbols.length)];
        el.style.left = `${48 + Math.random() * 4}%`;
        el.style.top = `${48 + Math.random() * 4}%`;
        el.style.setProperty('--x', `${(Math.random() - .5) * 360}px`);
        el.style.setProperty('--y', `${-80 - Math.random() * 260}px`);
        el.style.setProperty('--r', `${(Math.random() - .5) * 80}deg`);
        el.style.animationDelay = `${Math.random() * .16}s`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 1700);
      }
    }

    yesBtn.addEventListener('click', () => {
      burstPetals();
      openModal('好，那今晚见。', '我会准时到。<br />希望今晚的晚风也刚刚好。');
    });

    maybeBtn.addEventListener('click', () => {
      openModal('没关系，慢慢想。', '这顿饭的决定权交给你。<br />等你愿意的时候，再告诉我。');
    });

    closeBtn.addEventListener('click', () => overlay.classList.remove('show'));
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) overlay.classList.remove('show');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') overlay.classList.remove('show');
    });
  </script>
</body>
</html>
